{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agile status",
  "type": "object",
  "required": ["schema_version", "project", "workflow", "automation", "features", "stories", "releases", "change_requests", "pending_revalidation", "gate_summary", "approvals", "checkpoints", "last_updated_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "project": {
      "type": "object",
      "required": ["name", "profile", "agile_root"],
      "properties": {
        "profile": {"enum": ["app", "game"]}
      },
      "additionalProperties": true
    },
    "workflow": {
      "type": "object",
      "required": ["current_stage", "current_state", "blocked", "recovery_required"],
      "properties": {
        "current_stage": {"type": ["string", "null"]},
        "current_state": {"type": "string"},
        "blocked": {"type": "boolean"},
        "recovery_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "automation": {"type": "object", "required": ["model", "machine_gates_auto_advance"]},
    "features": {"type": "object"},
    "stories": {"type": "object"},
    "releases": {"type": "object"},
    "change_requests": {"type": "object"},
    "pending_revalidation": {"type": "array"},
    "gate_summary": {"type": "object", "required": ["passed", "failed", "waived"]},
    "approvals": {"type": "object", "required": ["records"]},
    "checkpoints": {"type": "object", "required": ["latest", "history"]},
    "last_updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
