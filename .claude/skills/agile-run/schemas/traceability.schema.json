{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traceability",
  "type": "object",
  "required": ["schema_version", "scope", "feature_id", "story_id", "links", "coverage", "gate_status"],
  "properties": {
    "schema_version": {"type": "string"},
    "scope": {"enum": ["feature", "story", "release"]},
    "feature_id": {"type": "string", "pattern": "^FEA-[0-9]{4}-[0-9]{4}-[a-z0-9][a-z0-9-]*$"},
    "story_id": {"type": ["string", "null"], "pattern": "^US-[0-9]{3}-[a-z0-9][a-z0-9-]*$"},
    "links": {
      "type": "object",
      "required": ["requirement_refs", "prd_refs", "story_refs", "fid_refs", "tdd_flows", "bdd_scenarios", "implementation_refs", "evidence_refs", "git_refs", "release_refs"],
      "properties": {
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "prd_refs": {"type": "array", "items": {"type": "string"}},
        "story_refs": {"type": "array", "items": {"type": "string"}},
        "fid_refs": {"type": "array", "items": {"type": "string"}},
        "tdd_flows": {"type": "array", "items": {"type": "object"}},
        "bdd_scenarios": {"type": "array", "items": {"type": "object"}},
        "implementation_refs": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "object"}},
        "git_refs": {
          "type": "object",
          "required": ["branches", "commits", "pull_requests", "issues", "merge"],
          "properties": {
            "branches": {"type": "array", "items": {"type": "string"}},
            "commits": {"type": "array", "items": {"type": "string"}},
            "pull_requests": {"type": "array", "items": {"type": "string"}},
            "issues": {"type": "array", "items": {"type": "string"}},
            "merge": {
              "type": "object",
              "properties": {
                "commit": {"type": ["string", "null"]},
                "method": {"type": ["string", "null"]}
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "release_refs": {"type": "array"}
      },
      "additionalProperties": true
    },
    "coverage": {"type": "object", "required": ["acceptance_criteria", "uncovered_criteria"]},
    "gate_status": {
      "type": "object",
      "required": ["traceability_complete", "evidence_complete"],
      "properties": {
        "traceability_complete": {"enum": ["pending", "passed", "failed", "waived"]},
        "evidence_complete": {"enum": ["pending", "passed", "failed", "waived"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
