{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature",
  "type": "object",
  "required": ["schema_version", "feature", "workflow", "acceptance_criteria", "documents", "ddd_policy", "stories", "traceability", "quality_gates", "approvals"],
  "properties": {
    "schema_version": {"type": "string"},
    "feature": {
      "type": "object",
      "required": ["id", "slug", "title", "profile", "risk", "owner", "status", "created_at", "updated_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^FEA-[0-9]{4}-[0-9]{4}-[a-z0-9][a-z0-9-]*$"},
        "profile": {"enum": ["app", "game"]},
        "risk": {"enum": ["low", "medium", "high"]},
        "status": {"enum": ["in_progress", "accepted", "blocked", "cancelled"]}
      },
      "additionalProperties": true
    },
    "workflow": {"type": "object", "required": ["current_stage", "current_state", "blocked", "recovery_required"]},
    "acceptance_criteria": {"type": "array"},
    "documents": {"type": "object", "required": ["prd", "ddd", "feature_acceptance"]},
    "ddd_policy": {"type": "object", "required": ["required", "reason", "waiver"]},
    "stories": {"type": "array"},
    "traceability": {"type": "object", "required": ["file"]},
    "quality_gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "approvals": {"type": "object", "required": ["records"]}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed", "waived"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
